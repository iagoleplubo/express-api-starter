@startuml
title Foodtruck API - Class Diagram

class Pizza {
  +int id
  +string name
  +string imageUrl
  +float price
  +string created_at
  +string updated_at
  +static create(obj) : Promise<Pizza>
  +static findAll() : Promise<Pizza[]>
  +static findById(id) : Promise<Pizza|null>
  +static update(id, obj) : Promise<Pizza|null>
  +static delete(id) : Promise<number>
  +static addIngredients(pizzaId, ingredientIds) : Promise<void>
}

class Ingredient {
  +int id
  +string name
  +float price
  +string created_at
  +string updated_at
  +static create(obj) : Promise<Ingredient>
  +static findAll() : Promise<Ingredient[]>
  +static findById(id) : Promise<Ingredient|null>
  +static findByNames(names) : Promise<Ingredient[]>
  +static update(id, obj) : Promise<Ingredient|null>
  +static delete(id) : Promise<number>
}

class PizzasController {
  +create(req, res)
  +findAll(req, res)
  +findOne(req, res)
  +update(req, res)
  +delete(req, res)
}

class IngredientsController {
  +create(req, res)
  +findAll(req, res)
  +findOne(req, res)
  +update(req, res)
  +delete(req, res)
  +resolveByNames(names) : Promise<Ingredient[]>
}

class Router {
  +GET /api/pizzas
  +POST /api/pizzas
  +GET /api/pizzas/:id
  +PUT /api/pizzas/:id
  +DELETE /api/pizzas/:id
  +GET /api/ingredients
  +POST /api/ingredients
  +GET /api/ingredients/:id
  +PUT /api/ingredients/:id
  +DELETE /api/ingredients/:id
}

Pizza "1..*" -- "1..*" Ingredient : contient >

PizzasController -- Pizza : uses >
IngredientsController -- Ingredient : uses >
PizzasController ..> IngredientsController : resout les ingredients >
Router --> PizzasController : routes to >
Router --> IngredientsController : routes to >

@enduml